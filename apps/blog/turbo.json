{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "BLOG_ORIGIN",
        "BLOG_OWNER_EMAIL",
        "NOTION_TOKEN",
        "AUTH_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "AUTH_URL",
        "AUTH_TRUST_HOST",
        "BLOG_MEDIA_HOSTS",
        "VERCEL_ENV"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env.local"]
    },
    "dev": {
      "passThroughEnv": [
        "BLOG_ORIGIN",
        "BLOG_OWNER_EMAIL",
        "NOTION_TOKEN",
        "AUTH_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "AUTH_URL",
        "AUTH_TRUST_HOST",
        "BLOG_MEDIA_HOSTS",
        "BLOG_FIXTURES"
      ]
    },
    "test": {
      "env": ["BLOG_FIXTURES"]
    }
  }
}
