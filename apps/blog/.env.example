# App-local; never expose these through NEXT_PUBLIC variables.
NOTION_TOKEN=
BLOG_OWNER_EMAIL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3004
BLOG_ORIGIN=https://blog.animesh.cc
# Only set on a trusted deployment behind Vercel or your own reverse proxy.
AUTH_TRUST_HOST=false
# Optional comma-separated additional exact HTTPS media hostnames.
BLOG_MEDIA_HOSTS=
# Development only: explicit seven-article inspection fixtures; prohibited in production.
BLOG_FIXTURES=false

# Optional Search Console URL-prefix verification token
GOOGLE_SITE_VERIFICATION=
